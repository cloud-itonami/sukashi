{
  "@context": {
    "@vocab": "https://etzhayyim.com/ns/actor#",
    "id": "@id",
    "type": "@type"
  },
  "id": "actor:sukashi",
  "type": "Actor",
  "name": "sukashi",
  "glyph": "透かし",
  "displayNameJa": "透かし (すかし)",
  "displayNameEn": "Sukashi — Ad-Tech Supply-Chain + Delivery-Infra + Fraud-Network Observatory",
  "purpose": "Ad-tech supply-chain + delivery-infrastructure + fraud-network observatory. Datafies the programmatic advertising ecosystem from the PUBLIC IAB web-standard files (ads.txt / app-ads.txt / sellers.json): the ad-tech entities (DSP / ad-exchange / SSP / ad-network / publisher / verification), the first-class AUTHORIZATION edges + the two-sided handshake whose GAPS reveal spoofed / unauthorized inventory, the creatives (who broadcasts what), the DELIVERY edges binding a creative to its serving infrastructure (IP / ASN / WHOIS-org — reusing tadori's ip-network + passive-dns ontologies), and NON-ADJUDICATING fraud signals routed to the actors that act. The ad-tech-supply-chain + fraud sibling of akashi 証 (which observes platform ad-LIBRARY disclosures). A fraud-PROTECTION + ad-tech-TRANSPARENCY map, NEVER a target-list, NEVER an ad-buying / optimization / targeting / detection-evasion tool (Charter 広告排除 invariant preserved — this is meta-observation OF advertising, not advertising).",
  "purposeJa": "アドテク・サプライチェーン + 配信インフラ + 詐欺ネットワークの観測所。公開 IAB 標準ファイル（ads.txt / app-ads.txt / sellers.json）からプログラマティック広告エコシステムを kotoba Datom 化：アドテク事業者（DSP/取引所/SSP/ネットワーク/媒体社/検証）、認可エッジと両者ハンドシェイクの不整合（なりすまし在庫の検出面）、クリエイティブ（誰が何を発信しているか）、配信エッジ（クリエイティブ→IP/ASN/WHOIS組織、tadori の ip-network+passive-dns を再利用）、非裁定の詐欺シグナルを行動アクターへ routing。akashi 証（広告ライブラリ開示の観測）の supply-chain+詐欺の姉妹。詐欺保護+アドテク透明化の地図であり、標的リストでも広告出稿/最適化/検知回避ツールでもない（広告排除 invariant 保持 — これは広告の観測であって広告ではない）。",
  "status": "R0-design-only",
  "tier": "B",
  "adr": "2606071600",
  "dependsOnAdr": ["2606022300", "2606031600", "2605301400", "2605312500", "2606060900", "2605301600", "2605262130", "2605312345", "2606013600", "2606013800", "2605215000", "2605192100"],
  "schema": ["00-contracts/schemas/ad-supply-chain-ontology.kotoba.edn"],
  "reuses": [
    "00-contracts/schemas/ip-network-ontology.kotoba.edn (:ip/:asn delivery-infra refs — tadori, ADR-2606031600)",
    "00-contracts/schemas/passive-dns-cti-ontology.kotoba.edn (:domain/:tlscert delivery-infra refs)"
  ],
  "substrate": {
    "state": "kotoba Datom log (ADR-2605312345) — IPFS block backend, MST ingress, Base L2 anchor",
    "largeAssets": "DataLad → IPFS (80-data/ad-supply-chain) — creative media / deepfake evidence; NO git-lfs",
    "inference": "Murakumo-only (ADR-2605215000)",
    "render": "in-browser kotoba-wasm node (ADR-2606013600) — /search + /actors + fraud-network viz query the Datom log client-side, no server round-trip"
  },
  "integrates": ["actor:akashi", "actor:tadori", "actor:kurashimori", "actor:tasuke", "actor:danjo", "actor:kabuto", "actor:tsumugi", "actor:himotoki"],
  "cells": [
    {
      "id": "cell:sukashi.crawl",
      "method": "methods/crawl.py",
      "input": "data/frontier-domains.edn (real publisher/SSP/exchange domains) — the worldwide acquisition frontier",
      "output": ["data/live/<domain>.<kind> (gitignored)", "rows → ingest parsers → kotoba"],
      "pipeline": "frontier walk → urls_for (only /ads.txt /app-ads.txt /sellers.json /rdap — public IAB/RDAP paths) → fetch (INJECTED network leg; GET-only honest-UA robots no-evasion, G2/G12) → ingest.parse_* → :adtech/:adauth.edge/:addelivery.edge rows; RDAP org-only (G9); resume-safe (fresh-skip). DRY-RUN unless SUKASHI_OPERATOR_GATE=1.",
      "gate": "G7 — a LIVE crawl requires SUKASHI_OPERATOR_GATE=1 + Council; dry-run otherwise (returns the URL plan, fetches nothing). Proven live: theguardian.com/ads.txt → 131 rows. bb sukashi:crawl.",
      "runtime": ".py (I/O-coupled acquisition, the ingest.py boundary — ADR-2606131800; the analyzer is .cljc)"
    },
    {
      "id": "cell:sukashi.ingest",
      "method": "methods/ingest.py",
      "input": "data/ingest/*.{txt,json} (a publisher's ads.txt / app-ads.txt, an exchange's sellers.json, an RDAP/WHOIS JSON) or seed",
      "output": ["data/ad-supply-chain.merged.kotoba.edn"],
      "pipeline": "public IAB file → real parser (ads.txt/sellers.json/WHOIS) → normalize to :adtech/:adauth.edge/:addelivery.edge → dedup-merge with seed (seed wins). WHOIS keeps registrant ORG only; personal registrants dropped (G9).",
      "gate": "G7 — live full-web crawl (millions of ads.txt/sellers.json/WHOIS) requires SUKASHI_OPERATOR_GATE (Council); offline/seed mode default. Bridged real files are :authoritative; signals remain :synthesized (G5)."
    },
    {
      "id": "cell:sukashi.analyze",
      "method": "methods/analyze.py",
      "input": "data/ad-supply-chain.merged.kotoba.edn (or data/seed-ad-supply-chain.kotoba.edn)",
      "output": ["out/intel-report.md", "out/ad-fraud-clusters.kotoba.edn"],
      "pipeline": "classify → authorization-handshake integrity (declared-but-unconfirmed unconfirmed-rate) → account-id collision (domain-spoof surface) → delivery-infra concentration (ASN/registrar) → fraud clustering (shared-infra scam-ad networks) → category load → routing tally (aggregate-first, non-adjudicating)"
    },
    {
      "id": "cell:sukashi.transact",
      "method": "methods/transact.py",
      "input": "data/ad-supply-chain.merged.kotoba.edn + ad-supply-chain-ontology.kotoba.edn",
      "output": ["kotoba Datom log via com.etzhayyim.apps.kotoba.datomic.transact"],
      "pipeline": "rows → [:db/add E A V] datoms + schema install → batched POST. Dry-run default.",
      "gate": "G7 — live write requires KOTOBA_TOKEN operator JWT (sub==operator_did) OR a CACAO authorising datom:transact; NO platform-held key (ADR-2605231525)"
    },
    {
      "id": "cell:sukashi.viz",
      "method": "viz/build_viz_data.py",
      "input": "data/seed-ad-supply-chain.kotoba.edn",
      "output": ["viz/ad-supply-chain.json", "viz/ad-supply-chain.htm"],
      "pipeline": "graph → payload → self-contained canvas force-graph (ad-tech entities by role, auth/delivery edges, fraud clusters highlighted, click → entity panel). Browser-native via the kotoba-wasm node (ADR-2606013600); inlined payload = offline data contract."
    },
    {
      "id": "cell:sukashi.fraud-bridge",
      "method": "(design) → com.etzhayyim.akashi.malakEvidenceCandidate",
      "input": "out/ad-fraud-clusters.kotoba.edn + :adfraud.signal/* (routed-to :akashi-malak)",
      "output": ["akashi malakEvidenceCandidate records (evidence-only, reviewStatus candidate-only)"],
      "pipeline": "fraud signal (≥2 source CIDs) → akashi's existing malak evidence bridge — sukashi NEVER runs its own malak import or accusation (G4/G13)",
      "gate": "G11 — handoff to akashi is review-gated; sukashi emits candidate evidence only, never a finding"
    }
  ],
  "lexiconNamespaces": [
    "com.etzhayyim.sukashi.registerAdtech",
    "com.etzhayyim.sukashi.registerAuthEdge",
    "com.etzhayyim.sukashi.registerCreative",
    "com.etzhayyim.sukashi.registerFraudSignal",
    "com.etzhayyim.sukashi.publishIntelReport",
    "com.etzhayyim.sukashi.socialPost"
  ],
  "display": {
    "did": "did:web:etzhayyim.com:actor:sukashi",
    "didDoc": "https://etzhayyim.com/actor/sukashi/did.json",
    "search": "https://etzhayyim.com/search (in-browser kotoba-wasm node)",
    "registry": "50-infra/etzhayyim-did-web/src/registry/infra-actors.ts (INFRA_ACTORS.sukashi)"
  },
  "gates": {
    "G1": "public ad-tech transparency data ONLY — ads.txt / app-ads.txt / sellers.json (public IAB web-standard files), creative content as-published, public WHOIS-org / DNS / IP / ASN. OUT OF SCOPE: private user data, who-SAW / who-CLICKED an ad, first-party audience segments, RTB bidstream, impression-level PII",
    "G2": "observatory-not-network / protection-not-promotion — sukashi NEVER serves / brokers / places / optimizes / targets ads; never a demand or supply node; never a commercial ad-intel terminal (Charter 広告排除 invariant + Charter Rider §2(e) + akashi G9). Concentration routed to takedown-referral + redundancy, NEVER a target-list",
    "G3": "aggregate-first + claimed-first output",
    "G4": "no adjudication — sukashi states evidence-bearing fraud SIGNALS with confidence + evidence-CID, routed to actors that act; it does NOT rule that an entity committed fraud (UPL / defamation boundary; sibling of danjo + akashi). every signal carries :non-adjudicating true",
    "G5": "sourcing honesty (:authoritative public files | :representative bounded sample | :synthesized sukashi-computed); every fraud signal + cluster is :synthesized; real ad-tech firms carry NO fraud signal; no fabricated coverage; absence ≠ legitimacy",
    "G6": "Murakumo-only narration (ADR-2605215000)",
    "G7": "outward-gated INGEST — live full-web ads.txt / sellers.json / WHOIS / DNS crawl = SUKASHI_OPERATOR_GATE + Council; offline/seed + single-file bridge default",
    "G8": "no git-lfs; creative media / deepfake evidence → DataLad → IPFS (80-data/ad-supply-chain)",
    "G9": "no personal PII — WHO-PAID is advertiser-disclosed corporate only; NO data on individuals who viewed/clicked; WHOIS keeps registrant ORG only (personal registrants dropped); a deepfake-endorsement victim's likeness → encrypted-envelope evidence-CID, person excluded from the public graph",
    "G10": "browser-native render — /search + /actors + fraud-network viz run in the in-browser kotoba-wasm node, no server query round-trip (ADR-2606013600)",
    "G11": "outward-gated PUBLISH — live atproto social posting = SUKASHI_LIVE_POST + operator auth; every post body passes a Charter Rider §2(a)-(h) scan; fraud handoff to akashi is review-gated, candidate-evidence only",
    "G12": "read-only / no-interaction — never places / clicks an ad, never spends, never submits a landing-page form; fetch is observational GET/HEAD of PUBLIC files only; NO click-fraud, NO anti-bot bypass, and NO capability that helps an advertiser EVADE fraud detection (weaponizable use structurally unrepresentable)",
    "G13": "complements akashi, does not duplicate — sukashi = ad-tech supply chain + delivery infra + fraud clusters; akashi = platform ad-library disclosure. fraud evidence is handed to akashi's com.etzhayyim.akashi.malakEvidenceCandidate bridge; sukashi does not run its own malak import"
  }
}
